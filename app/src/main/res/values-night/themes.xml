<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Clandestinely" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sand_yellow</item>
        <item name="colorOnPrimary">@color/navy_deep</item>
        <item name="colorSecondary">@color/mist_blue</item>
        <item name="colorOnSecondary">@color/navy_deep</item>
        <item name="colorSecondaryContainer">@color/sand_yellow</item>
        <item name="colorOnSecondaryContainer">@color/navy_deep</item>
        <item name="android:colorBackground">@color/navy_deep</item>
        <item name="colorOnBackground">@color/sand_yellow</item>
        <item name="colorSurface">@color/navy_mid</item>
        <item name="colorSurfaceContainer">@color/navy_mid</item>
        <item name="colorOnSurface">@color/sand_yellow</item>
        <item name="colorOnSurfaceVariant">@color/mist_blue</item>
        <item name="colorOutline">@color/mist_blue</item>
        <item name="colorError">@color/brick_red</item>
        <item name="colorOnError">@color/sand_yellow</item>
        <item name="android:statusBarColor">@color/navy_deep</item>
        <item name="android:navigationBarColor">@color/navy_deep</item>

        <item name="android:fontFamily">@font/abhaya_libre_regular</item>
        <item name="fontFamily">@font/abhaya_libre_regular</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Cuaca.HeadlineLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Cuaca.LabelLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Cuaca.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Cuaca.BodyMedium</item>

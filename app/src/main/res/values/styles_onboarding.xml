<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding uses the plain Android sans-serif font for a cleaner look. Colours come from the app theme. -->
<resources>
    <style name="Onb" />

    <!-- The app theme's default text appearances carry the Abhaya Libre font file, which would
         override a font set by name. These plain appearances replace them on onboarding screens. -->
    <style name="TextAppearance.Onb" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Onb.Medium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Onb.Title">
        <item name="android:textAppearance">@style/TextAppearance.Onb</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="Onb.Body">
        <item name="android:textAppearance">@style/TextAppearance.Onb</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Onb.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Onb.Medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Matches the mist-blue pill buttons in Intan's Welcome page design. -->
    <style name="Onb.Button.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Onb.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Onb.Medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>

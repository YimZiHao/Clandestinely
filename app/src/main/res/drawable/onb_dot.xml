<?xml version="1.0" encoding="utf-8"?>
<!-- Page dots under the onboarding slides: long pill for the current page, small dot for the others. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:width="20dp" android:height="8dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="?attr/colorPrimary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="8dp" android:height="8dp" android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="?attr/colorOutline" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
